<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="trabalhoeduardov._1._1_.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="0">

           
            <Border
                BackgroundColor="#202040"
                Padding="25,35"
                StrokeThickness="0">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="4 PERSONAGENS QUE MARCARAM MINHA INFÂNCIA"
                        TextColor="White"
                        FontSize="34"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"/>

                    <Label
                        Text="Personagens que estiveram presentes na minha infância"
                        TextColor="#D8D8FF"
                        FontSize="17"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"/>

                </VerticalStackLayout>

            </Border>


          
            <VerticalStackLayout
                Padding="25,30"
                Spacing="20">

                <Label
                    Text="Bem-vindo! 👋"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#202040"/>

                <Label
                    Text="Biogrfia dos meus 4 personagens favoritos"
                    FontSize="18"
                    TextColor="#555555"/>


                
                <Border
                    BackgroundColor="#F1F0FF"
                    Stroke="#D5D2FF"
                    StrokeThickness="1"
                    Padding="20">

                    <VerticalStackLayout
                        Spacing="12">

                        <Label
                            Text="📚 Sobre o APP"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="#202040"/>

                        <Label
                            Text="Este aplicativo apresenta a biografia de quatro personagens marcantes dos desenhos que fizeram parte da minha  infância, e de muitas pessoas."
                            FontSize="16"
                            TextColor="#444444"
                            LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>

                </Border>


               
                <Border
                    BackgroundColor="#202040"
                    Padding="20"
                    StrokeThickness="0">

                    <VerticalStackLayout
                        Spacing="10">

                        <Label
                            Text="☰  Explore os personagens"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold"/>

                        <Label
                            Text="Abra o menu no canto superior e escolha um personagem para conhecer sua história e sua biografia."
                            TextColor="#D8D8FF"
                            FontSize="16"
                            LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>

                </Border>


                <Label
                    Text="⭐ Escolha um personagem e comece a explorar!"
                    FontSize="17"
                    FontAttributes="Bold"
                    TextColor="#202040"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,10,0,20"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>


</ContentPage>
